modules = ["nodejs-24", "java-graalvm22.3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "database-routing"

[[workflows.workflow]]
name = "database-routing"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["gradle"]

[userenv]

[userenv.shared]
BUYME_COMPANY_ADMIN_EMAIL = "ashfaqhkamalapura@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-38e45e2b-d260-4561-8a85-69db10ce8067"
