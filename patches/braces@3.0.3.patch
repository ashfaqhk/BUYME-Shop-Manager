diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..2a0012333f8f4d15301b4c4c64ceae52019cecc3
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Bound public AST walkers too: callers may pass an AST without using parse.
+module.exports = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  const seen = new WeakSet();
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 64 || seen.has(node)) throw new TypeError('Brace AST nesting exceeds the safe limit');
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
